{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["vitest/globals"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"gallery/**/*.ts",
		"gallery/**/*.svelte",
		"vite.config.ts",
		"vite.config.gallery.ts"
	]
}
