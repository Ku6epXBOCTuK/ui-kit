{
	"name": "@ku6epxboctuk/ui-kit",
	"version": "0.10.1",
	"type": "module",
	"description": "Design tokens and Svelte 5 components shared by my projects",
	"author": "Ku6epXBOCTuK <Ku6epXBOCTuK@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Ku6epXBOCTuK/ui-kit.git"
	},
	"homepage": "https://github.com/Ku6epXBOCTuK/ui-kit#readme",
	"bugs": {
		"url": "https://github.com/Ku6epXBOCTuK/ui-kit/issues"
	},
	"keywords": [
		"design-tokens",
		"svelte",
		"svelte5",
		"ui",
		"components"
	],
	"exports": {
		"./tokens.css": "./tokens.css",
		"./kawaii.css": "./tokens/kawaii.css",
		"./headless/*.svelte.ts": "./src/headless/*.svelte.ts",
		"./components/*.svelte": {
			"types": "./src/components/*.svelte.d.ts",
			"svelte": "./src/components/*.svelte",
			"default": "./src/components/*.svelte"
		},
		"./tokens/*": "./tokens/*"
	},
	"files": [
		"tokens.css",
		"tokens/",
		"docs/",
		"!tokens/tool.src.css",
		"src/",
		"!src/**/*.spec.*"
	],
	"sideEffects": [
		"*.css"
	],
	"publishConfig": {
		"access": "public"
	},
	"packageManager": "pnpm@12.15.0",
	"scripts": {
		"build:themes": "node scripts/build-themes.mjs",
		"build:types": "node scripts/build-types.mjs",
		"check:tokens": "node scripts/check-tokens.mjs",
		"check:types": "node scripts/build-types.mjs --check",
		"docs:build": "node scripts/build-docs.mjs",
		"docs:check": "node scripts/build-docs.mjs --check",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "vitest run",
		"gallery": "vite --config vite.config.gallery.ts",
		"dev": "vite --config vite.config.gallery.ts --open",
		"build:gallery": "vite build --config vite.config.gallery.ts",
		"preview": "node scripts/preview.mjs",
		"prepublishOnly": "pnpm check && pnpm test && pnpm build:themes && pnpm docs:check && pnpm check:types"
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"@fontsource/comfortaa": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/nunito": "^5.3.0",
		"@panmdaa/colors": "^0.4.2",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"postcss": "^8.5.26",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^4.1.12"
	}
}
